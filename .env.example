# OpenAI (extraction/mapping/prose => gpt-4o ; classification => gpt-4o-mini)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_EXTRACT=gpt-4o
LLM_MODEL_CLASSIFY=gpt-4o-mini

# Docling runs in-process via the `docling` package (no Docker service).
# OCR engine: 'auto' => Apple Vision (ocrmac) on macOS, EasyOCR elsewhere.
#   Other choices: ocrmac | easyocr | rapidocr | tesseract
DOCLING_OCR_ENGINE=auto
DOCLING_DO_OCR=true
DOCLING_TABLE_MODE=fast        # fast | accurate (bill-pay needs text only -> fast)
DOCLING_NUM_THREADS=4

# Per-page router: a page is OCR'd only if it has < MIN_CHARS of text AND a raster
# image covers >= MIN_IMAGE_COVERAGE of it (i.e. it's a scanned page, not digital).
DOCLING_OCR_MIN_CHARS=50
DOCLING_OCR_MIN_IMAGE_COVERAGE=0.5

# Chat app auth (optional). Set CHAT_PASSWORD to require a login before exposing
# the chat publicly (protects your OpenAI key). Leave unset for local use.
CHAT_USERNAME=manager
# CHAT_PASSWORD=change-me-strong

# RAG / vector store (Postgres + pgvector). Leave DATABASE_URL empty to disable
# (pipeline then writes Excel only). EMBED_MODEL must match the chunks.embedding
# dimension (text-embedding-3-small = 1536).
DATABASE_URL=postgresql://rag:rag@localhost:5436/rag
# To expose the DB to a manager: harden creds (strong rag password + a
# read-only 'manager_ro' login) and run scripts/share_db.sh (ngrok TCP).
# Never expose the default rag/rag. Real passwords live in .env, not here.
EMBED_MODEL=text-embedding-3-small
CHUNK_MAX_CHARS=800

# Paths. PROCESSED_DIR / SKIPPED_DIR are where the Airflow DAG archives PDFs
# after a run (relevant -> processed, irrelevant -> skipped).
INPUT_DIR=./input
# Chat-app uploads land here (separate from INPUT_DIR so they never collide
# with the Airflow DAG that watches INPUT_DIR). Files stay here after processing.
UPLOAD_DIR=./upload
OUTPUT_DIR=./output
PROCESSED_DIR=./processed
SKIPPED_DIR=./skipped
